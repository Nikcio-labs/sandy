{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sandy",
  "version": "0.1.0",
  "identifier": "dev.sandy.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "splash",
        "title": "Sandy",
        "width": 320,
        "height": 200,
        "center": true,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": true
      },
      {
        "label": "main",
        "title": "Sandy",
        "width": 1280,
        "height": 820,
        "minWidth": 780,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'",
      "assetProtocol": {
        "enable": false,
        "scope": []
      },
      "pattern": {
        "use": "isolation",
        "options": {
          "dir": "isolation"
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 Nikolaj Brask-Nielsen",
    "homepage": "https://github.com/Nikcio-labs/sandy",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "publisher": "Nikcio-labs",
    "shortDescription": "A desktop app for Docker Sandboxes, powered by the sbx CLI.",
    "longDescription": "Sandy is a desktop app for Docker Sandboxes with guided setup, reusable environment templates, and local sandbox management, powered by the sbx CLI.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
